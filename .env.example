# Copy to .env (repo root). Both backend/ and frontend/ read this one file.
# Only variables prefixed with VITE_ are exposed to the browser.

# --- Backend (Copilot Runtime, backend/server.ts) -------------------------

# Model provider key for the BuiltInAgent. OpenAI is the quickstart default.
OPENAI_API_KEY=
# Only needed if you switch COPILOT_MODEL to an Anthropic / Google model.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Model used by every BuiltInAgent (format: provider:model or provider/model).
# Default: openai:gpt-6-luna (the value on the Vue quickstart page).
COPILOT_MODEL=openai:gpt-6-luna

# Runtime port. The frontend expects 8200 unless VITE_RUNTIME_URL changes.
PORT=8200

# MCP Apps page: an MCP Apps server to attach to the `mcp-apps` agent.
# Leave empty to disable. Example from the docs: https://mcp.excalidraw.com/mcp
MCP_APPS_SERVER_URL=

# Troubleshooting → Debug Mode: true | verbose (verbose logs full payloads; may contain PII).
COPILOT_DEBUG=

# --- Frontend (Vite, frontend/) -------------------------------------------

# Copilot Runtime endpoint the CopilotKitProvider points at.
VITE_RUNTIME_URL=http://localhost:8200/api/copilotkit

# CopilotKit public license key: only needed for Threads (CopilotKit Intelligence).
# Leave empty to test the unlicensed behaviour.
VITE_COPILOTKIT_PUBLIC_LICENSE_KEY=
